# ============================================
# SSL MODE OPTIONS
# ============================================
# Add ?sslmode=MODE to the end of DATABASE_URL

# require - Requires SSL (most secure, may fail on Windows)
# ?sslmode=require

# prefer - Try SSL, fallback to non-SSL (recommended for development)
# ?sslmode=prefer

# disable - No SSL (not recommended, but works on local dev)
# ?sslmode=disable

