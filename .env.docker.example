# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/<your-project>/settings/api

# Your Supabase project URL
SUPABASE_URL=https://pihrxzkkqutsebvpgokw.supabase.co

# Public anonymous key (safe to expose in frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBpaHJ4emtrcXV0c2VidnBnb2t3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM1OTcwNzcsImV4cCI6MjA4OTE3MzA3N30.0quhPN-PFH8UedZwbsiR20_-QkbraVbfmHvXvnlf734

# Service role key (KEEP SECRET - bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBpaHJ4emtrcXV0c2VidnBnb2t3Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3MzU5NzA3NywiZXhwIjoyMDg5MTczMDc3fQ.WsRBLK9u5PY_cY_MzUXTXdRDtf3-E662DYwAe4Ss0HQ

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Get the connection string from Supabase:
# https://app.supabase.com/project/<your-project>/settings/database

# Use connection pooling for better performance (port 6543)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.pihrxzkkqutsebvpgokw:95P9U2yAqbBEsiHe@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Alternative: Direct connection (port 5432) - use if pooler has issues
# DATABASE_URL=postgresql://postgres.pihrxzkkqutsebvpgokw:95P9U2yAqbBEsiHe@db.pihrxzkkqutsebvpgokw.supabase.co:5432/postgres

# If direct database connections fail, use Supabase REST API instead
USE_REST_API=true

# ============================================================
# SECURITY CONFIGURATION
# ============================================================
# JWT secret key for authentication tokens
# IMPORTANT: Generate a new random key for production
# You can generate one with: openssl rand -base64 32
SECRET_KEY=dalilio-super-secret-key-change-this-in-production-min-32-characters

# JWT algorithm (do not change unless you know what you're doing)
ALGORITHM=HS256

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# API KEYS
# ============================================================
# OpenRouter API key for AI/LLM functionality
# Get your key from: https://openrouter.ai/keys
# Required for the RAG chatbot feature
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY

# ============================================================
# OPTIONAL: FIREBASE CONFIGURATION
# ============================================================
# Path to Firebase credentials JSON file for push notifications
# Leave empty if not using Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
# Application environment (development, staging, production)
APP_ENV=production

# PHP error display (Off for production, On for development)
PHP_DISPLAY_ERRORS=Off

# PHP error logging (always On)
PHP_LOG_ERRORS=On

# ============================================================
# RENDER-SPECIFIC CONFIGURATION
# ============================================================
# These are automatically provided by Render
# PORT=10000 (Render auto-assigns this)
# RENDER=true (Render auto-sets this)
# IS_PULL_REQUEST=false (Render auto-sets this)

# ============================================================
# INSTRUCTIONS FOR RENDER DEPLOYMENT
# ============================================================
# 1. Go to your Render dashboard: https://dashboard.render.com/
# 2. Select your web service
# 3. Go to "Environment" tab
# 4. Click "Add Environment Variable"
# 5. Copy each variable from this file
# 6. For SECRET_KEY, click "Generate" to create a secure random value
# 7. Save changes and redeploy

# ============================================================
# SECURITY NOTES
# ============================================================
# ⚠️  NEVER commit real credentials to Git
# ⚠️  NEVER expose SUPABASE_SERVICE_ROLE_KEY publicly
# ⚠️  NEVER share DATABASE_URL with untrusted parties
# ⚠️  ALWAYS use environment variables on the deployment platform
# ⚠️  ALWAYS rotate keys if they are accidentally exposed
